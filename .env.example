# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_api_token

# Contact Form (Resend)
RESEND_API_KEY=your_resend_api_key
CONTACT_EMAIL_TO=leanne@birth-hood.co.uk

# Instagram Graph API (optional — falls back to static images if not set)
# Get a long-lived token from: https://developers.facebook.com/apps/
# Your Instagram account must be a Business or Creator account connected to a Facebook Page.
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Site URL (for SEO / OG tags)
NEXT_PUBLIC_SITE_URL=https://www.birth-hood.co.uk

# ── Shop (Stripe) ──
# From Stripe dashboard → Developers → API keys (use the SECRET key, sk_live_…)
STRIPE_SECRET_KEY=
# From Stripe dashboard → Developers → Webhooks → your endpoint → Signing secret (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Any long random string (used to sign download links). Generate: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=
